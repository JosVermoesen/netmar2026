@page "/customers"

@using BlazorApp.Services
@inject CustomerApiClient Api
@using Microsoft.AspNetCore.Components

<h3>Customers</h3>

<div class="mb-3">
    <label class="form-label">Search</label>
    <input class="form-control" @bind="_search" />

    <label class="form-label mt-2">Postal codes (comma separated)</label>
    <input class="form-control" @bind="_postalcodes" />

    <label class="form-label mt-2">Sort</label>
    <select class="form-select" @bind="_sort">
        <option value="desc">Descending</option>
        <option value="asc">Ascending</option>
    </select>

    <button class="btn btn-primary mt-2" @onclick="Search">Search</button>
</div>

@if (_isLoading)
{
    <p>Loading…</p>
}
else if (_error is not null)
{
    <p class="text-danger">@_error</p>
}
else if (_customers.Count == 0)
{
    <p>No customers found.</p>
}
else
{
    <p>
        Page @_pageIndex of @_totalPages,
        size @_pageSize,
        total @_totalCount
    </p>

    <div class="mb-2">
        <button class="btn btn-outline-secondary btn-sm me-1"
                @onclick="FirstPage"
                disabled="@IsFirstPage">
            « First
        </button>
        <button class="btn btn-outline-secondary btn-sm me-1"
                @onclick="PreviousPage"
                disabled="@IsFirstPage">
            ‹ Previous
        </button>
        <button class="btn btn-outline-secondary btn-sm me-1"
                @onclick="NextPage"
                disabled="@IsLastPage">
            Next ›
        </button>
        <button class="btn btn-outline-secondary btn-sm"
                @onclick="LastPage"
                disabled="@IsLastPage">
            Last »
        </button>
    </div>

    <table class="table table-sm">
        <thead>
        <tr>
            <th>Id</th>
            <th>Name (a100)</th>
            <th>Postal code (a107)</th>
            <th>City (a108)</th>
            <th>VAT/ID (a161)</th>
            <th>Email (v224)</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var c in _customers)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.A100</td>
                <td>@c.A107</td>
                <td>@c.A108</td>
                <td>@c.A161</td>
                <td>@c.V224</td>
                <td>
                    <NavLink class="btn btn-link btn-sm" href="@($"/customer/{c.Id}")">
                        Details
                    </NavLink>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private readonly List<CustomerApiClient.CustomerListItem> _customers = [];
    private bool _isLoading = true;
    private string? _error;

    private string _search = "roelandt";
    private string _postalcodes = "9300";
    private string _sort = "desc"; // "asc" or "desc"

    private int _pageIndex = 1;
    private int _pageSize = 6;
    private int _totalCount;
    private int _totalPages => _pageSize > 0
        ? (int)Math.Ceiling((double)_totalCount / _pageSize)
        : 1;

    private bool IsFirstPage => _pageIndex <= 1;
    private bool IsLastPage => _pageIndex >= _totalPages;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task Search()
    {
        _pageIndex = 1;
        await LoadCustomers();
    }

    private async Task FirstPage()
    {
        if (IsFirstPage) return;
        _pageIndex = 1;
        await LoadCustomers();
    }

    private async Task PreviousPage()
    {
        if (IsFirstPage) return;
        _pageIndex--;
        await LoadCustomers();
    }

    private async Task NextPage()
    {
        if (IsLastPage) return;
        _pageIndex++;
        await LoadCustomers();
    }

    private async Task LastPage()
    {
        if (IsLastPage) return;
        _pageIndex = _totalPages;
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        _isLoading = true;
        _error = null;
        _customers.Clear();

        try
        {
            var result = await Api.GetCustomersAsync(
                sort: _sort,
                search: _search,
                postalcodes: _postalcodes,
                pageIndex: _pageIndex,
                pageSize: _pageSize);

            _pageIndex = result.PageIndex;
            _pageSize = result.PageSize;
            _totalCount = result.Count;

            _customers.AddRange(result.Data);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}