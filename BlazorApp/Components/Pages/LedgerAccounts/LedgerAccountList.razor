@page "/ledgeraccounts"

@using BlazorApp.Services
@inject LedgerAccountApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Ledger accounts</PageTitle>

<h3>Ledger accounts</h3>

<div class="mb-3">
    <form class="row g-2" @onsubmit="OnSearchAsync">
        <div class="col-auto">
            <input class="form-control"
                   placeholder="Search..."
                   @bind="Search"
                   @bind:event="oninput" />
        </div>
        <div class="col-auto">
            <select class="form-select" @bind="Sort">
                <option value="">Sort (none)</option>
                <option value="asc">Account ↑</option>
                <option value="desc">Account ↓</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>
</div>

@if (IsLoading)
{
    <p>Loading...</p>
}
else if (Result is null || Result.Data.Count == 0)
{
    <p>No ledger accounts found.</p>
}
else
{
    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>Account (v019)</th>
                <th>Description (v020)</th>
                <th class="text-end">Dece028</th>
                <th class="text-end">Dece029</th>
                <th class="text-end">Dece030</th>
                <th class="text-end">Dece031</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Result.Data)
            {
                <tr>
                    <td>@item.V019</td>
                    <td>@item.V020</td>
                    <td class="text-end">@item.Dece028</td>
                    <td class="text-end">@item.Dece029</td>
                    <td class="text-end">@item.Dece030</td>
                    <td class="text-end">@item.Dece031</td>
                    <td>
                        <button type="button"
                                class="btn btn-link btn-sm p-0"
                                @onclick="@(() => NavigateToDetail(item.Id))">
                            Details
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (TotalPages > 1)
    {
        <nav aria-label="Ledger account pages">
            <ul class="pagination">
                <li class="page-item @(PageIndex == 1 ? "disabled" : null)">
                    <button type="button"
                            class="page-link"
                            @onclick="PreviousPage"
                            disabled="@(PageIndex == 1)">
                        Previous
                    </button>
                </li>

                <li class="page-item disabled">
                    <span class="page-link">
                        Page @PageIndex of @TotalPages (@Result.Count total)
                    </span>
                </li>

                <li class="page-item @(PageIndex == TotalPages ? "disabled" : null)">
                    <button type="button"
                            class="page-link"
                            @onclick="NextPage"
                            disabled="@(PageIndex == TotalPages)">
                        Next
                    </button>
                </li>
            </ul>
        </nav>
    }
}

@code {
    private string? Search { get; set; } = "klant";
    private string? Sort { get; set; } = "asc";

    private int PageIndex { get; set; } = 1;
    private int PageSize { get; } = 20;

    private LedgerAccountApiClient.LedgerAccountListResult? Result { get; set; }
    private bool IsLoading { get; set; }

    private int TotalPages =>
        Result is null || Result.PageSize == 0
            ? 1
            : (int)Math.Ceiling(Result.Count / (double)Result.PageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task OnSearchAsync()
    {
        PageIndex = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;

        try
        {
            Result = await ApiClient.GetLedgerAccountsAsync(
                sort: Sort,
                search: Search,
                pageIndex: PageIndex,
                pageSize: PageSize);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task PreviousPage()
    {
        if (PageIndex <= 1)
        {
            return;
        }

        PageIndex--;
        await LoadAsync();
    }

    private async Task NextPage()
    {
        if (PageIndex >= TotalPages)
        {
            return;
        }

        PageIndex++;
        await LoadAsync();
    }

    private void NavigateToDetail(int id)
    {
        Navigation.NavigateTo($"/ledgeraccount/{id}");
    }
}